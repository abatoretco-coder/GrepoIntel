{
  "manifest_version": 3,
  "name": "GrepoIntel Companion",
  "version": "0.1.0",
  "description": "Passive, read-only local state export for GrepoIntel.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "*://*.grepolis.com/*", "*://*.grepolis.fr/*"],
  "background": {"scripts": ["dist/background.js"]},
  "web_accessible_resources": [{"resources": ["dist/injected/page.js", "dist/adapters/grepolis/adapter.js", "dist/sanitize.js"], "matches": ["*://*.grepolis.com/*", "*://*.grepolis.fr/*"]}],
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["*://*.grepolis.com/*", "*://*.grepolis.fr/*"], "js": ["dist/content.js"], "run_at": "document_idle"},{"matches":["http://localhost/*"],"js":["dist/localhost-bridge.js"],"run_at":"document_idle"}]
}
